# Copy this file to .env and fill in your values.
# Get your authtoken at: https://dashboard.ngrok.com/get-started/your-authtoken
NGROK_AUTHTOKEN=

# Your reserved (static, non-random) free ngrok domain, e.g. your-name.ngrok-free.app
# Create/reserve one at: https://dashboard.ngrok.com/domains
NGROK_DOMAIN=

# Cloud LLM free tiers
# Groq: https://console.groq.com/keys  ·  Gemini: https://aistudio.google.com/apikey
GROQ_API_KEY=
GEMINI_API_KEY=

# Internal service keys (generate with: openssl rand -hex 32)
# LITELLM_MASTER_KEY must start with "sk-", e.g. sk-<hex>
LITELLM_MASTER_KEY=
RICA_INTERNAL_KEY=
SEARXNG_SECRET=

# Private knowledge repo (read via deploy key in secrets/rica_deploy_key)
KNOWLEDGE_REPO=git@github.com:<you>/rica-knowledge.git
KNOWLEDGE_BRANCH=main

# What RICA calls you until _rica/profile.md sets preferred_name
OWNER_NAME=

TZ=Asia/Dhaka
